{
  "name": "dcards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build && pnpm build:migrate && pnpm build:seed",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "lint:fix": "eslint src scripts --max-warnings 0 --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml,css}\"",
    "comments:check": "tsx scripts/comments/check.ts",
    "verify": "pnpm format:check && pnpm comments:check && pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/modules/core/db/migrate.ts",
    "db:seed:admin": "tsx --env-file-if-exists=.env scripts/db/seed-admin.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env scripts/db/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v --timeout 5",
    "build:migrate": "esbuild src/modules/core/db/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=.next/standalone/migrate.mjs",
    "build:seed": "esbuild scripts/db/seed-admin.ts --bundle --platform=node --format=esm --target=node24 --external:argon2 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=.next/standalone/seed-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.4",
    "nodemailer": "9.1.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp"
    ]
  }
}
