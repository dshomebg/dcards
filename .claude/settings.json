{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TodoWrite",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git reset:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git reset:*)",
      "PowerShell(.\\scripts\\deploy-prod.ps1:*)",
      "PowerShell(./scripts/deploy-prod.ps1:*)",
      "PowerShell(.\\scripts\\rollback-prod.ps1:*)",
      "PowerShell(./scripts/rollback-prod.ps1:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network prune:*)",
      "Bash(docker volume rm:*)",
      "PowerShell(docker system prune:*)",
      "PowerShell(docker volume prune:*)",
      "PowerShell(docker network prune:*)",
      "PowerShell(docker volume rm:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-gates.mjs",
            "timeout": 120,
            "statusMessage": "Спирачките преди пълната проверка…"
          }
        ]
      }
    ]
  }
}
