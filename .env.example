# DCARDS — копирай като .env и попълни. .env НЕ влиза в git.

# Идентичност на инсталацията — влиза в имената на Docker ресурсите.
APP_SLUG=dcards
APP_NAME=DCARDS
APP_URL=http://localhost:3100
PORT=3100
# Адрес върху картите (/c/{id}); липсва → APP_URL. Веднъж отпечатан, не се сменя.
# CARD_URL_BASE=https://dcrd.bg

# База (dev: docker-compose.dev.yml)
POSTGRES_USER=dcards
POSTGRES_PASSWORD=dcards
POSTGRES_DB=dcards_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://dcards:dcards@127.0.0.1:5433/dcards_dev

# Redis — сесии, rate limit, кеш (ARC-3)
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# Сесии
SESSION_SECRET=change-me-32-bytes-min

# Първият админ се създава със seed, не от env:
#   pnpm db:seed:admin -- --email admin@example.com --password <8+ знака>
# Липсващ аргумент се чете от SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD / SEED_ADMIN_NAME.

# Файлове — локален том (ARC-4)
UPLOADS_DIR=./uploads

# Поща (Hestia, INF-3)
MAIL_HOST=mail.dcards-bg.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=info@dcards-bg.com
MAIL_PASS=
MAIL_FROM="DCARDS <info@dcards-bg.com>"
# Копие на всяка нова поръчка до този адрес; празно = без. Празен MAIL_HOST в dev печата
# писмата в конзолата.
MAIL_ADMIN_TO=

# Магазин
STORE_CURRENCY=BGN
STORE_LOCALE=bg-BG
# Доставка в стотинки (minor units); липсва → 590
SHIPPING_COST_MINOR=590
